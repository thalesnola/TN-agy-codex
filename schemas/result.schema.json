{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AgyCodexResult",
  "type": "object",
  "required": ["task_id", "status", "worker", "unreviewed_local_output"],
  "properties": {
    "task_id": { "type": "string" },
    "status": { "type": "string", "enum": ["ok", "error", "rejected"] },
    "worker": { "type": "string" },
    "model": { "type": "string" },
    "output_text": { "type": "string" },
    "patch": { "type": "string" },
    "unreviewed_local_output": { "type": "boolean" },
    "error_message": { "type": "string" },
    "duration_s": { "type": "number" },
    "artifacts": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": false
}
